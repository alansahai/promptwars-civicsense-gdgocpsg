# CivicResolve Environment Variables
# The platform functions out-of-the-box with NO environment variables (Demo Fallback Mode).
# Set these keys for live production deployment and full AI capabilities.

# Google Gemini API
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# Admin Authentication
# A default demo password is provided in demo mode; change in production!
ADMIN_PASSWORD="civic-demo-2026"
TOKEN_SECRET="civicresolve-secret-key-change-in-production-min-32-chars"

# Municipal Location
CITY_NAME="Coimbatore"

# Upstash Redis Storage (Optional: defaults to InMemoryRepository if blank)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Server Environment & CORS
VERCEL_ENV="development"
ALLOWED_ORIGINS="*"
DEMO_MODE="true"
